# Переменные окружения портала экспонентов.
# Реальные значения живут в Vercel (Project → Settings → Environment Variables)
# и в локальном .env.local, который в git не попадает.
# Vercel применяет новые переменные только на СЛЕДУЮЩЕМ деплое — после правки
# нужен Redeploy.

# --- Обязательные: без них портал отвечает 503 ---

# Проект Supabase под MOTO-ZÜRICH: `motozuerich-ausstellerportal`,
# регион eu-central-2 (Цюрих) — данные остаются в Швейцарии.
# Отдельный от платформенного проекта, это осознанное решение.
SUPABASE_URL=https://nitvaqtqttaykkqmdumk.supabase.co

# Ключ service_role. Только на сервере, никогда в браузер — он обходит RLS.
# Берётся в дашборде: Project Settings → API. В репозиторий не попадает.
SUPABASE_SERVICE_ROLE_KEY=

# Публикуемый ключ. Нужен для Supabase Auth (отправка и проверка кода входа).
# Не секрет — он и рассчитан на то, чтобы быть открытым. Но у нас используется
# ТОЛЬКО на сервере: браузер в Supabase не ходит вообще, он говорит с нашими
# роутами. Поэтому без префикса NEXT_PUBLIC_ — в бандл он попасть не должен.
SUPABASE_ANON_KEY=sb_publishable_ZHIlqH-0aiaCKIzaeZeQlQ_lu9_JdPW

# --- Необязательные: без них работает, но урезанно ---

# Отправка писем (коды входа, уведомления о заявках). Аккаунт Resend общий
# для платформы, план Pro, регион Ireland.
RESEND_API_KEY=

# Отправитель писем портала. Домен обязан быть верифицирован в Resend,
# иначе отправка падает.
PORTAL_FROM_EMAIL=MOTO-ZÜRICH <noreply@motozuerich.ch>

# Куда попадёт ответ, если экспонент нажмёт «Ответить». Должен быть живой ящик:
# отправляем с noreply@, а отвечать людям нужно человеку.
PORTAL_REPLY_TO=yves@motozuerich.ch

# Базовый адрес для ссылок в письмах.
PUBLIC_BASE_URL=https://motozuerich-ausstellerportal.vercel.app

# --- Защита от писем настоящим людям с тестовых окружений ---

# Если задано, ВСЕ письма уходят на этот адрес вместо настоящего получателя,
# а настоящий адрес подставляется в тему: «[TEST → firma@example.ch] …».
#
# Задавать в Vercel на окружениях Preview и Development, а также локально.
# В Production переменной быть НЕ должно.
#
# Включается только явно: если бы перехват включался «сам, когда не прод»,
# одна ошибка в определении окружения молча съела бы боевую почту.
PORTAL_MAIL_OVERRIDE=assistant@creox.ch
